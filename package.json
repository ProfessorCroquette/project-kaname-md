		"@mdsvex/plugin-elements": "next",
		"@mdsvex/plugin-external-links": "next",
		"@mdsvex/plugin-figures": "next",
		"@mdsvex/plugin-link-check": "next",
		"@mdsvex/plugin-page-data": "next",
		"@mdsvex/plugin-references": "next",
		"@mdsvex/plugin-tabs": "next",
		"@mdsvex/plugin-toc": "next",
		"@mdsvex/prettier-plugin": "next",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
